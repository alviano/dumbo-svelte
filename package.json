	"type": "module",
	"dependencies": {
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@sveltestrap/sveltestrap": "^7.1.0",
		"codemirror": "^6.0.2",
		"dompurify": "3.3.1",
		"eslint-plugin-svelte": "^3.15.0",
		"highlight.js": "^11.11.1",
		"isomorphic-dompurify": "^3.0.0-rc.2",
		"js-base64": "^3.7.8",
		"js-sha256": "^0.11.1",
		"katex": "0.16.33",
		"locally-unique-id-generator": "^0.1.8",
		"markdown-it": "^14.1.1",
		"pako": "^2.1.0",
		"string-from-charcodes": "^2.0.1",
