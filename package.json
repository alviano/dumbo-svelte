		"@types/dompurify": "^3.2.0",
		"@types/katex": "^0.16.8",
		"@types/markdown-it": "^14.1.2",
		"@types/pako": "^2.0.4",
		"@typescript-eslint/eslint-plugin": "^8.55.0",
		"@typescript-eslint/parser": "^8.55.0",
		"eslint": "^9.39.2",
		"eslint-config-prettier": "^10.1.8",
		"prettier": "^3.8.1",
		"prettier-plugin-svelte": "^3.4.1",
		"sass": "^1.97.3",
		"svelte-check": "^4.3.6",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3",
		"vite": "7.3.1",
		"vitest": "4.0.18"
